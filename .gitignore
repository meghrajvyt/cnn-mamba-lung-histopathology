# ── Results: the metrics, per-image predictions, explanation scores, tables
# and figures behind the paper are tracked; the rest is regenerable ──
results/**
!results/**/
!results/**/evaluation_results.json
!results/**/xai_metrics.json
!results/**/predictions.npz
!results/**/xai_per_sample.npz
!results/_paper/*.json
!results/_paper/*.md
!results/_paper/figures/*.pdf
!results/_efficiency/*.json
results/**/xai_heatmaps/

